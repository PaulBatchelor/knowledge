IP_ADDRESS=10.11.99.1
if [ "$#" -eq 0 ]
then
echo "Usage: $0 filename.pdf"
exit 1
fi

for FILE in $*
do
    echo Uploading $FILE
    curl 'http://'$IP_ADDRESS'/upload'\
         -H 'Origin: http://'$IP_ADDRESS \
         -H 'Accept: */*'\
         -H 'Referer: http://'$IP_ADDRESS'/'\
         -H 'Connection: keep-alive'\
         -F "file=@$FILE;filename="$FILE";type=application/pdf"
     echo
done

